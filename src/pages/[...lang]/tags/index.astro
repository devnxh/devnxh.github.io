---
import Section from '../../../components/Section.astro';
import { langFromParam, plural, staticLangPaths, useTranslations } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import { getTags } from '../../../lib/content';
import { tagUrl } from '../../../lib/obsidian/remark/inline';

export const getStaticPaths = staticLangPaths;

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);
const tags = await getTags(lang);
---

<Base lang={lang} title={t('tags.title')} section="writeups">
  <header class="page-head">
    <h1>{t('tags.title')}</h1>
    <p class="lede">{tags.length}</p>
  </header>
  <div class="notebook">
    <Section index={0}>
      {
        tags.length > 0 ? (
          <ul class="tag-list">
            {tags.map((group) => (
              <li>
                <a class="tag" href={tagUrl(group.tag, { lang })}>#{group.tag}</a>
                <span class="count num" title={plural(t, 'tags.count', group.count)}>{group.count}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">{t('writeups.empty')}</p>
        )
      }
    </Section>
  </div>
</Base>
